# ---------------------------------------------------------------
# Toronto Coffee Guide — environment variables
# Copy to .env.local and fill in. Every variable is optional:
# without them the site runs from data/cafes.seed.json and shows
# neutral photo placeholders.
# ---------------------------------------------------------------

# Google Maps Platform — SERVER-SIDE key (Places API (New)).
# Used only in route handlers / server components / scripts. Never exposed to the browser.
# Restrict it to "Places API (New)" in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Google Maps JavaScript API — BROWSER key for the /map page (optional).
# This key IS public by design: restrict it by HTTP referrer and to "Maps JavaScript API" only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID for Advanced Markers / cloud styling
NEXT_PUBLIC_GOOGLE_MAP_ID=

# How long (seconds) live Place Details are cached by Next.js before refetching.
PLACES_REVALIDATE_SECONDS=3600

# Supabase (optional). When both are set the site reads cafes from the database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — ONLY used by scripts (npm run db:seed / places:sync). Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
