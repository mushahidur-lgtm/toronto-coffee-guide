# ---------------------------------------------------------------
# Toronto Coffee Guide — environment variables
# Copy to .env.local and fill in. Every variable is optional:
# without them the site runs from data/cafes.seed.json and shows
# neutral photo placeholders.
# ---------------------------------------------------------------

# Google Maps Platform — SERVER-SIDE key (Places API (New)).
# Powers live cafe photos (/api/place-photo), hours/addresses, and the place-ID scripts.
# Used only on the server; never exposed to the browser. Do NOT prefix it with NEXT_PUBLIC_.
# Restrict it to "Places API (New)" in Google Cloud Console.
GOOGLE_PLACES_API_KEY=
# (GOOGLE_MAPS_API_KEY is also accepted, for older setups)

# The map (/map and cafe pages) uses OpenStreetMap tiles and needs no key. Cafe coordinates come from the City of
# Toronto open address data (see scripts/geocode.ts), not from Google.

# How long (seconds) live Place Details are cached by Next.js before refetching.
PLACES_REVALIDATE_SECONDS=86400

# The map's "Patio" filter uses Google's live outdoorSeating, which bills Place Details at the
# Atmosphere tier. Set to false to skip it (Patio then uses editorial "patio" tags only).
PLACES_ATMOSPHERE_FIELDS=true

# Supabase (optional). When both are set the site reads cafes from the database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — ONLY used by scripts (npm run db:seed / places:sync). Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
